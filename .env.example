# Safe by default. Set to 1 only when you intentionally want external calls.
RECOVERAI_LIVE_EXECUTION=1

# Razorpay Payment Links (ALTERNATIVE_PAYMENT)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SMTP recovery email (RECOVERY_REMINDER)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# 587 + STARTTLS is recommended; 465 + SSL is also supported.
SMTP_STARTTLS=1
SMTP_USE_SSL=0
# Never use insecure SMTP in production unless you intentionally accept the risk.
SMTP_ALLOW_INSECURE=0

# Twilio SMS (RECOVERY_REMINDER with channel=sms)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Optional Twilio Test Credentials for SANDBOX. With these, API requests are simulated and no SMS is sent.
TWILIO_TEST_ACCOUNT_SID=
TWILIO_TEST_AUTH_TOKEN=
TWILIO_TEST_FROM=+15005550006
# Optional public callback URL for delivery-status events.
TWILIO_STATUS_CALLBACK_URL=

# Generic recovery orchestration webhook (RETRY_LATER / HUMAN_ESCALATION)
RECOVERAI_EXECUTION_WEBHOOK_URL=
# Secret used to sign outbound orchestration webhooks. Falls back to RECOVERAI_WEBHOOK_SECRET if omitted.
RECOVERAI_EXECUTION_WEBHOOK_SECRET=

# HMAC secret for authenticated payment/recovery verification callbacks
RECOVERAI_WEBHOOK_SECRET=

# Execution safety plane
# DEMO = no external calls; SANDBOX = only test Razorpay keys + allow-listed destinations; PRODUCTION = live providers with explicit action allow-list.
RECOVERAI_EXECUTION_ENV=DEMO
RECOVERAI_LIVE_KILL_SWITCH=0
RECOVERAI_ADMIN_TOKEN=change-me
RECOVERAI_MAX_LIVE_AMOUNT=10000
RECOVERAI_DAILY_LIVE_BUDGET=50000
# Razorpay TEST payment-link execution is safe because SANDBOX requires rzp_test_* keys.
# This flag is only used by PRODUCTION for this action.
RECOVERAI_ALLOW_ALTERNATIVE_PAYMENT=1
RECOVERAI_ALLOW_RECOVERY_REMINDER=0
RECOVERAI_ALLOW_RETRY_LATER=0
RECOVERAI_ALLOW_HUMAN_ESCALATION=0

# SANDBOX safety: only these destinations may receive real test email/SMS.
RECOVERAI_SANDBOX_EMAIL=your-test-email@example.com
RECOVERAI_SANDBOX_PHONE=+91XXXXXXXXXX

# Razorpay webhook secret (separate from API secret).
RAZORPAY_WEBHOOK_SECRET=

# Production real-time recovery (disabled by default)
RECOVERAI_PRODUCTION_EXECUTION_ARMED=0
